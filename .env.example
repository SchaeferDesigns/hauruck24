# Mailversand fuer das Anfrageformular.
# Ohne diese Werte zeigt das Formular automatisch den E-Mail-Weg als Ausweichloesung.
# Zugangsdaten beim eigenen Hoster (nicht bei einem Drittanbieter) anlegen,
# dann bleibt die Verarbeitung DSGVO-seitig unkompliziert.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Absenderadresse, muss zum SMTP-Konto passen
MAIL_FROM="Hauruck24 Website <noreply@hauruck24.de>"

# Empfaenger der Anfragen
MAIL_TO=info@hauruck24.de
