# Die Website wird als statischer Export gebaut, es gibt keinen eigenen Server.

# Vorschau unter einem Unterpfad bauen, zum Beispiel fuer
# https://schaeferdesigns.de/demo/hauruck24/
# Leer lassen fuer den Live-Build an der Domainwurzel.
# npm run build:vorschau setzt den Wert selbst.
NEXT_PUBLIC_BASE_PATH=

# Optional: Adresse eines Formular-Dienstes, der JSON per POST annimmt
# und mit Status 2xx antwortet (eigenes PHP-Skript, Cloudflare Worker oder
# ein Formular-Dienst mit Serverstandort in der EU).
# Leer: Das Anfrageformular oeffnet zum Absenden das E-Mail-Programm,
# bietet "Angaben kopieren" und den Anruf an.
NEXT_PUBLIC_FORM_ENDPOINT=
